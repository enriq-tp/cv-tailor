# Copy this file to .env and replace every change_me. The real .env is never committed.

# Read by docker-compose.yml to create the database the first time.
POSTGRES_USER=cvtailor
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cvtailor

# Read by Prisma and by scripts/db-check.ts. Host port 5433 (5432 is often used by
# a native PostgreSQL install). Keep user/password/db equal to the values above.
DATABASE_URL=postgresql://cvtailor:change_me@localhost:5433/cvtailor
